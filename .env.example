# Copy to .env — docker compose reads it automatically.
APP_ID=APP_000123
APP_PASSWORD=change-me
DAILY_AMOUNT=5.00
DAILY_CURRENCY=XTS
SMS_SHORTCODE=3030
BILLING_TZ=UTC
# SECONDS before retry attempt N (length of the list = retry budget)
GRACE_RETRY_INTERVALS_SEC=120,300,600
THROTTLE_RETRY_SEC=1
# E1318 throttle: own bounded budget, never consumes the grace budget above
THROTTLE_MAX_RETRIES=10
# >0: cron triggers the daily job automatically; 0 = trigger it manually (demo)
JOB_INTERVAL_MINUTES=0
# false = accept stable masked aliases instead of real MSISDNs
MSISDN_STRICT=true

# --- optional hardening (empty = disabled, demo works as before) -----------------
# Shared secret for inbound webhooks §B/§C. The contract defines no signature,
# so both sides must be given the same value: the mock sends X-Webhook-Secret.
WEBHOOK_SECRET=
# Bearer token for operator/finance handles: POST /jobs/*, GET /admin/*
SERVICE_API_TOKEN=
